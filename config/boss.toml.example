# Example configuration for the openspec-boss.
# Copy to ~/.config/openspec-boss/boss.toml and adjust to taste
# (or let 'boss' generate a file for you on first use).

default = "opencode"

[runners.opencode]
kind = "opencode"
args = []
# The apply template matches the runner's habit: opencode applies tend to leave
# their work uncommitted, so ask for that explicitly and let the boss review the
# working tree. claude tends to commit, so ask it to commit (see below).
apply = "/opsx-apply {change} Leave the changed files uncommitted for review."
# Optional: environment variables set for the tab this runner is started in.
# Without the field an opencode runner gets the built-in default
# OPENCODE_CONFIG_CONTENT={"permission":"allow"}, which grants allow-all only
# inside boss tabs. Set your own list to replace it, or env = [] to disable it.
# env = ["OPENCODE_CONFIG_CONTENT={\"permission\":\"ask\"}"]
# Optional: instruction appended to every apply prompt (and reused by retrigger).
# Leave the field out to use the built-in default ("end your turn, do not wait
# for a review"). Set yield = "" to send no instruction.
# yield = "Stop after this turn; the boss is woken automatically."

[runners.claude]
kind = "claude"
args = ["--permission-mode", "bypassPermissions"]
# Whether an apply commits depends on the runner; state the expectation here,
# once, instead of repeating it in every --note. Free text after the command is
# sent to the agent along with it.
apply = "/opsx:apply {change} Commit your work with a clear message when done."
# Optional: wait for this text in the pane before the first prompt, so a cold
# start cannot produce agent_prompt_stalled. ready_regex = true treats the
# value as a Rust regex; ready_timeout_ms defaults to 90000 (raise it on slow
# hosts). Without the field boss does not wait for a marker.
# ready = "? for shortcuts"
# ready_regex = false
# ready_timeout_ms = 90000
# Optional: answer a first-run dialog with these keys. With
# --permission-mode bypassPermissions claude shows a consent prompt on its
# first start; accept it once manually, or let boss do it here.
# dialog_match = "Yes, I accept"
# dialog_keys = ["enter"]

[projects]
shop = "~/work/shop"
api = "~/work/api"

# Optional: the test command 'boss review' runs per project, keyed by the
# registry name. Without an entry boss detects one from the project (Justfile,
# package.json + lockfile, pytest with uv.lock/poetry.lock, Makefile); if it
# finds none, the review reports not_run instead of a false fail.
[tests]
shop = "uv run pytest -q"

# Optional: the two stores for verified lessons. The global store belongs to
# this machine and is never written into a project repo; the project store
# lives in the project (relative to its root). Both are plain Markdown with an
# '## Active' (injected into the next apply prompt) and an '## Log' section.
# A leading ~ is expanded; BOSS_LESSONS_GLOBAL overrides lessons.global.
[lessons]
global = "~/.config/openspec-boss/lessons.md"
project = "openspec/lessons.md"

# Optional: the directory of the mission docs, relative to the project root
# (default openspec/missions); an absolute or ~ path is used as is and a
# leading ~ is expanded. A configuration without this table keeps the default.
[missions]
dir = "openspec/missions"
