#!/usr/bin/env bash
# boss -- single control session for OpenSpec apply cycles across projects.
# Subcommands: dispatch, status, retrigger, finish, answer, config-json.

set -u

BIN_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=./boss-lib.sh
. "$BIN_DIR/boss-lib.sh"

usage() {
  cat >&2 <<'EOF'
boss -- control session for OpenSpec apply cycles (see README.md)

Usage:
  boss dispatch <change> [--project <name|path>] [--runner <name>]
  boss status [<change>] [--project <name|path>] [--json]
  boss retrigger <change> [--project <name|path>]
  boss finish <change> [--project <name|path>] [--force]
  boss answer <change> <key>... [--project <name|path>]
  boss config-json
  boss --help
EOF
  exit 2
}

# ---------------------------------------------------------------- config ---

config_json() {
  local out rc
  [ -f "$BOSS_CONFIG" ] || die_json "config_missing" "config file not found: $BOSS_CONFIG"
  require_cmd python3
  out="$(python3 - "$BOSS_CONFIG" 2>&1 <<'PY'
import sys
try:
    import tomllib
except ModuleNotFoundError:
    sys.exit("python3 >= 3.11 is required to read boss.toml (module tomllib missing)")
import json
with open(sys.argv[1], "rb") as f:
    json.dump(tomllib.load(f), sys.stdout)
PY
)"
  rc=$?
  if [ "$rc" -ne 0 ]; then
    die_json "config_invalid" "cannot parse $BOSS_CONFIG: $out"
  fi
  printf '%s\n' "$out"
}

apply_template_for() {
  case "$1" in
    claude|gemini) printf '/opsx:apply {change}' ;;
    codex) printf '$openspec-apply-change {change}' ;;
    *) printf '/opsx-apply {change}' ;;
  esac
}

# ensure_config -- generate $BOSS_CONFIG from installed agents on first use;
# an existing file is never overwritten.
ensure_config() {
  [ -f "$BOSS_CONFIG" ] && return 0

  local dir
  dir="$(dirname "$BOSS_CONFIG")"
  mkdir -p "$dir" || die_json "config_write" "cannot create config dir: $dir"

  local kinds="claude gemini opencode copilot kilo qwen cursor codex"
  local found="" kind
  for kind in $kinds; do
    if command -v "$kind" >/dev/null 2>&1; then
      found="$found $kind"
    fi
  done
  found="${found# }"

  local header
  header="# Generated by 'boss' on $(date '+%Y-%m-%d %H:%M:%S %Z')."

  if [ -z "$found" ]; then
    {
      printf '%s\n' "$header"
      printf '%s\n' "# No supported agent (claude, gemini, opencode, copilot, kilo, qwen, cursor, codex) was found in PATH."
      printf '%s\n' "# Add a [runners.<name>] entry and set 'default', then run the command again."
    } >"$BOSS_CONFIG"
    die_json "no_agent_found" "no supported agent found in PATH; wrote a template to $BOSS_CONFIG -- add a runner and retry"
  fi

  local default_runner
  case " $found " in
    *" opencode "*) default_runner="opencode" ;;
    *) default_runner="${found%% *}" ;;
  esac

  {
    printf '%s\n' "$header"
    printf '%s\n' "# Edit freely -- boss never overwrites this file."
    printf '%s\n' "# default: runner used when none is given on the command line."
    printf '%s\n' "# [runners.<name>]: kind = agent kind, args = extra agent start arguments,"
    printf '%s\n' "#                  apply = OpenSpec apply command template ({change} is replaced)."
    printf '%s\n' "# [projects]: name -> repo path (absolute or ~), so projects can be addressed by name."
    printf 'default = "%s"\n' "$default_runner"
    for kind in $found; do
      printf '\n[runners.%s]\n' "$kind"
      printf 'kind = "%s"\n' "$kind"
      if [ "$kind" = "claude" ]; then
        printf 'args = ["--permission-mode", "bypassPermissions"]\n'
      else
        printf 'args = []\n'
      fi
      printf 'apply = "%s"\n' "$(apply_template_for "$kind")"
    done
    printf '\n[projects]\n'
    printf '# shop = "~/work/shop"\n'
  } >"$BOSS_CONFIG"
  log "generated config at $BOSS_CONFIG (default runner: $default_runner)"
}

# resolve_runner [<name>] -- print runner JSON {name, kind, args, apply};
# uses the default runner when no name is given.
resolve_runner() {
  local name="${1:-}" cfg
  cfg="$(config_json)" || exit 1
  if [ -z "$name" ]; then
    name="$(printf '%s' "$cfg" | jq -r '.default // empty')"
    [ -n "$name" ] || die_json "no_default_runner" "no default runner configured in $BOSS_CONFIG"
  fi
  local runner configured
  runner="$(printf '%s' "$cfg" | jq -c --arg n "$name" '.runners[$n]')"
  if [ "$runner" = "null" ]; then
    configured="$(printf '%s' "$cfg" | jq -r '(.runners // {}) | keys | join(", ") | if . == "" then "(none)" else . end')"
    die_json "unknown_runner" "unknown runner '$name'; configured runners: $configured"
  fi
  printf '%s\n' "$runner" | jq -c --arg n "$name" '. + {name: $n}'
}

# find_openspec_root <dir> -- nearest ancestor containing openspec/, or empty
find_openspec_root() {
  local dir="$1"
  while [ -n "$dir" ] && [ "$dir" != "/" ]; do
    if [ -d "$dir/openspec" ]; then
      printf '%s' "$dir"
      return 0
    fi
    dir="$(dirname "$dir")"
  done
  return 1
}

# resolve_project [<name|path>] -- print the absolute project path.
# Registry name, existing directory, or upward search from $PWD.
resolve_project() {
  local name="${1:-}" cfg project
  cfg="$(config_json)" || exit 1
  if [ -z "$name" ]; then
    project="$(find_openspec_root "$PWD")"
    if [ -z "$project" ]; then
      die_json "project_unknown" "cannot derive a project from $PWD (no openspec/ found upwards)"
    fi
  else
    project="$(printf '%s' "$cfg" | jq -r --arg n "$name" '.projects[$n] // empty')"
    if [ -z "$project" ]; then
      if [ -d "$(expand_home "$name")" ]; then
        project="$name"
      else
        local registered
        registered="$(printf '%s' "$cfg" | jq -r '(.projects // {}) | keys | join(", ") | if . == "" then "(none)" else . end')"
        die_json "project_unknown" "unknown project '$name'; registered projects: $registered"
      fi
    fi
  fi
  project="$(canonical_path "$project")"
  [ -d "$project/openspec/changes" ] || die_json "project_invalid" "'$project' is not an OpenSpec project (missing openspec/changes)"
  printf '%s\n' "$project"
}

# ------------------------------------------------------- boss identity (D4) ---

# ensure_boss_name <mode> -- register the calling pane as Herdr agent
# $BOSS_AGENT_NAME unless the name is already taken by another pane.
ensure_boss_name() {
  local mode="${1:-status}"
  if [ "${HERDR_ENV:-}" != "1" ]; then
    case "$mode" in
      dispatch|retrigger|finish|answer)
        die_json "not_in_herdr" "boss $mode requires a Herdr pane (HERDR_ENV is not set); run the boss session inside Herdr"
        ;;
      *)
        log "warning: not running inside Herdr; the boss agent identity is unavailable"
        ;;
    esac
    return 0
  fi

  local pane_id
  pane_id="${HERDR_PANE_ID:-}"
  [ -n "$pane_id" ] || die_json "not_in_herdr" "HERDR_PANE_ID is not set; cannot register the boss agent"

  local agents owner
  agents="$(herdr_json agent list)" || exit 1
  owner="$(printf '%s' "$agents" | jq -r --arg n "$BOSS_AGENT_NAME" '.agents[]? | select(.name == $n) | .pane_id' | sed -n '1p')"
  if [ -n "$owner" ]; then
    if [ "$owner" = "$pane_id" ]; then
      return 0
    fi
    die_json "boss_exists" "agent '$BOSS_AGENT_NAME' already belongs to pane $owner; only one boss session at a time"
  fi

  herdr_json agent rename "$pane_id" "$BOSS_AGENT_NAME" >/dev/null || exit 1
  log "registered this pane as Herdr agent '$BOSS_AGENT_NAME'"
}

# ------------------------------------------------------ workspace mapping ---

# find_workspace_for_repo <path> -- workspace of a pane whose cwd is the repo
# or a subdirectory of it (exact match preferred), or empty.
find_workspace_for_repo() {
  local repo="$1" panes ws_id
  panes="$(herdr_json pane list)" || exit 1
  ws_id="$(printf '%s' "$panes" | jq -r --arg r "$repo" '[.panes[] | select(.cwd == $r) | .workspace_id] | .[0] // empty')"
  if [ -z "$ws_id" ]; then
    ws_id="$(printf '%s' "$panes" | jq -r --arg r "$repo/" '[.panes[] | select((.cwd // "") | startswith($r)) | .workspace_id] | .[0] // empty')"
  fi
  printf '%s' "$ws_id"
}

# ensure_workspace <path> <label> -- existing workspace for the repo or a new one
ensure_workspace() {
  local repo="$1" label="$2" ws_id created
  ws_id="$(find_workspace_for_repo "$repo")"
  if [ -n "$ws_id" ]; then
    printf '%s' "$ws_id"
    return 0
  fi
  created="$(herdr_json workspace create --cwd "$repo" --label "$label" --no-focus)" || exit 1
  ws_id="$(printf '%s' "$created" | jq -r '.workspace.workspace_id // .root_pane.workspace_id // empty')"
  [ -n "$ws_id" ] || die_json "workspace_create_failed" "herdr workspace create returned no workspace_id for $repo"
  printf '%s' "$ws_id"
}

# ---------------------------------------------------------- apply readiness ---

# check_apply_ready <project> <change> -- all applyRequires artifacts done?
check_apply_ready() {
  local project="$1" change="$2" out rc missing msg
  out="$(cd "$project" && openspec status --change "$change" --json 2>&1)"
  rc=$?
  if [ "$rc" -ne 0 ]; then
    msg="$(printf '%s' "$out" | jq -r '.status[0].message // empty' 2>/dev/null || true)"
    [ -n "$msg" ] || msg="$(printf '%s' "$out" | sed -n '1p')"
    die_json "change_not_found" "$msg"
  fi
  missing="$(printf '%s' "$out" | jq -r '
    . as $root
    | [ $root.applyRequires[]? as $id
        | select([ $root.artifacts[]? | select(.id == $id and .status == "done") ] | length == 0)
        | $id ]
    | join(", ")')"
  if [ -n "$missing" ]; then
    die_json "change_not_ready" "change '$change' in $project is not ready for apply; missing artifacts: $missing"
  fi
}

# find_running_apply <change> <project> -- {pane_id,tab_id,workspace_id} of a live
# apply for this change in this project (pane tokens os_change/os_phase or a live
# agent apply-<change>, both scoped to the project's working tree), or empty.
find_running_apply() {
  local change="$1" project="$2" panes agents hit
  panes="$(herdr_json pane list)" || exit 1
  hit="$(printf '%s' "$panes" | jq -c \
    --arg c "$change" --arg p "$project" --arg ps "$project/" \
    '[.panes[] | select((.tokens.os_change // "") == $c and (.tokens.os_phase // "") == "apply"
        and (((.cwd // "") == $p) or (((.cwd // "") | startswith($ps)))))
      | {pane_id, tab_id, workspace_id}] | .[0] // empty')"
  if [ -z "$hit" ] || [ "$hit" = "null" ]; then
    agents="$(herdr_json agent list)" || exit 1
    hit="$(printf '%s' "$agents" | jq -c \
      --arg n "apply-$(normalize_name "$change")" --arg p "$project" --arg ps "$project/" \
      '[.agents[] | select(.name == $n and (((.cwd // "") == $p) or (((.cwd // "") | startswith($ps)))))
        | {pane_id, tab_id, workspace_id}] | .[0] // empty')"
  fi
  printf '%s' "$hit"
}

# send_prompt <agent> <text> -- deliver a prompt and verify it took effect:
# herdr reports agent_prompt_stalled when the input did not lead to a working
# agent (e.g. the TUI was still booting), in which case we resend.
send_prompt() {
  local agent="$1" text="$2" attempt out rc code
  for attempt in 1 2 3; do
    out="$(herdr agent prompt "$agent" "$text" --wait --until working --timeout 30000 2>&1)"
    rc=$?
    if [ "$rc" -eq 0 ]; then
      return 0
    fi
    code="$(printf '%s' "$out" | jq -r '.error.code // "unknown"' 2>/dev/null || true)"
    case "$code" in
      agent_prompt_stalled|timeout)
        log "prompt did not take effect yet ($code); retrying (attempt $attempt)"
        sleep 2
        ;;
      *)
        die_json "prompt_failed" "sending prompt to $agent failed: $code"
        ;;
    esac
  done
  die_json "prompt_failed" "prompt did not take effect for $agent after 3 attempts"
}

# ---------------------------------------------------------------- dispatch ---

cmd_dispatch() {
  ensure_boss_name dispatch
  ensure_config

  local change="" project_name="" runner_name="" arg
  while [ $# -gt 0 ]; do
    arg="$1"; shift
    case "$arg" in
      --project) project_name="${1:-}"; shift ;;
      --runner) runner_name="${1:-}"; shift ;;
      -h|--help) usage ;;
      --*) usage_error "unknown option: $arg" ;;
      *) if [ -z "$change" ]; then change="$arg"; else usage_error "unexpected argument: $arg"; fi ;;
    esac
  done
  [ -n "$change" ] || usage_error "usage: boss dispatch <change> [--project <name|path>] [--runner <name>]"

  local runner project agent_name
  runner="$(resolve_runner "$runner_name")" || exit 1
  project="$(resolve_project "$project_name")" || exit 1
  check_apply_ready "$project" "$change"
  agent_name="$(apply_agent_name "$change")"

  local existing pane_id tab_id workspace_id
  existing="$(find_running_apply "$change" "$project")"
  if [ -n "$existing" ] && [ "$existing" != "null" ]; then
    pane_id="$(printf '%s' "$existing" | jq -r '.pane_id')"
    tab_id="$(printf '%s' "$existing" | jq -r '.tab_id')"
    workspace_id="$(printf '%s' "$existing" | jq -r '.workspace_id')"
    printf '%s\n' "$(jq -n \
      --arg change "$change" --arg project "$project" \
      --arg runner "$(printf '%s' "$runner" | jq -r '.name')" \
      --arg agent "$agent_name" --arg pane_id "$pane_id" --arg tab_id "$tab_id" \
      --arg workspace_id "$workspace_id" --arg status "already_running" \
      '{change: $change, project: $project, runner: $runner, agent: $agent, pane_id: $pane_id, tab_id: $tab_id, workspace_id: $workspace_id, status: $status}')"
    return 0
  fi

  local kind apply_template apply_cmd
  kind="$(printf '%s' "$runner" | jq -r '.kind')"
  apply_template="$(printf '%s' "$runner" | jq -r '.apply')"
  local -a agent_args=()
  while IFS= read -r a; do agent_args+=("$a"); done < <(printf '%s' "$runner" | jq -r '.args[]? // empty')

  workspace_id="$(ensure_workspace "$project" "$(basename "$project")")"

  local created
  created="$(herdr_json tab create --workspace "$workspace_id" --cwd "$project" --label "$change" --no-focus)" || exit 1
  pane_id="$(printf '%s' "$created" | jq -r '.root_pane.pane_id // empty')"
  tab_id="$(printf '%s' "$created" | jq -r '.tab.tab_id // .root_pane.tab_id // empty')"
  [ -n "$pane_id" ] && [ -n "$tab_id" ] || die_json "tab_create_failed" "herdr tab create returned no pane/tab for $project"

  # Start the agent, retrying while the fresh shell pane is still busy.
  local started=0 deadline out rc code
  deadline=$(( $(date +%s%3N) + BOSS_AGENT_BUSY_RETRY_MS ))
  while [ "$(date +%s%3N)" -lt "$deadline" ]; do
    if [ "${#agent_args[@]}" -gt 0 ]; then
      out="$(herdr agent start "$agent_name" --kind "$kind" --pane "$pane_id" --timeout "$BOSS_AGENT_START_TIMEOUT_MS" -- "${agent_args[@]}" 2>&1)"
    else
      out="$(herdr agent start "$agent_name" --kind "$kind" --pane "$pane_id" --timeout "$BOSS_AGENT_START_TIMEOUT_MS" 2>&1)"
    fi
    rc=$?
    if [ "$rc" -eq 0 ]; then
      started=1
      break
    fi
    code="$(printf '%s' "$out" | jq -r '.error.code // ""' 2>/dev/null || true)"
    [ "$code" = "agent_pane_busy" ] || break
    log "agent start for $agent_name hit a busy pane; retrying"
    sleep 1
  done
  if [ "$started" -ne 1 ]; then
    msg="agent '$agent_name' did not become ready within the start timeout"
    if [ -n "$code" ] && [ "$code" != "agent_pane_busy" ]; then
      msg="agent '$agent_name' failed to start: $code"
    fi
    die_json "agent_not_ready" "$msg (pane $pane_id, tab $tab_id)"
  fi

  # Wait until the agent TUI is rendered before prompting.
  if ! out="$(herdr agent wait "$agent_name" --until idle --timeout 60000 2>&1)"; then
    code="$(printf '%s' "$out" | jq -r '.error.code // "unknown"' 2>/dev/null || true)"
    die_json "agent_not_ready" "agent '$agent_name' not ready before prompting ($code; pane $pane_id, tab $tab_id)"
  fi

  apply_cmd="${apply_template/\{change\}/$change}"
  send_prompt "$agent_name" "$apply_cmd"

  herdr_raw "pane.report_metadata" "$(jq -nc --arg p "$pane_id" --arg c "$change" \
    '{pane_id: $p, source: "openspec", tokens: {os_change: $c, os_phase: "apply"}}')" >/dev/null || exit 1

  local state_file now runner_name_out
  state_file="$(state_file_for "$project" "$change")"
  now="$(now_iso)"
  runner_name_out="$(printf '%s' "$runner" | jq -r '.name')"
  mkdir -p "$BOSS_APPLIES_DIR" || die_json "state_write" "cannot create state dir $BOSS_APPLIES_DIR"
  jq -n \
    --arg change "$change" --arg project "$project" --arg runner "$runner_name_out" \
    --arg kind "$kind" --arg apply_cmd "$apply_cmd" --arg agent "$agent_name" \
    --arg pane_id "$pane_id" --arg tab_id "$tab_id" --arg workspace_id "$workspace_id" \
    --arg started_at "$now" --arg last_state "working" --arg last_state_at "$now" \
    '{change: $change, project: $project, runner: $runner, kind: $kind, apply_cmd: $apply_cmd, agent: $agent, pane_id: $pane_id, tab_id: $tab_id, workspace_id: $workspace_id, waiter_pid: null, started_at: $started_at, last_state: $last_state, last_state_at: $last_state_at}' \
    >"$state_file" || die_json "state_write" "cannot write state file $state_file"

  setsid -f "$BIN_DIR/boss-waiter" "$state_file" >/dev/null 2>&1

  log "dispatch: change=$change project=$project runner=$runner_name_out agent=$agent_name tab=$tab_id pane=$pane_id workspace=$workspace_id"

  printf '%s\n' "$(jq -n \
    --arg change "$change" --arg project "$project" --arg runner "$runner_name_out" \
    --arg agent "$agent_name" --arg pane_id "$pane_id" --arg tab_id "$tab_id" \
    --arg workspace_id "$workspace_id" --arg status "started" \
    '{change: $change, project: $project, runner: $runner, agent: $agent, pane_id: $pane_id, tab_id: $tab_id, workspace_id: $workspace_id, status: $status}')"
}

# ------------------------------------------------------------------ state ---

# find_state_file <change> [<project-name>] -- state file for an apply
find_state_file() {
  local change="$1" project_name="${2:-}" norm files count f want
  norm="$(normalize_name "$change")"
  files="$(ls "$BOSS_APPLIES_DIR"/*-"$norm".json 2>/dev/null || true)"
  [ -n "$files" ] || die_json "no_apply" "no recorded apply for change '$change' (start one with 'boss dispatch $change')"
  count="$(printf '%s\n' "$files" | wc -l | tr -d ' ')"
  if [ "$count" -gt 1 ]; then
    if [ -n "$project_name" ]; then
      want="$(resolve_project "$project_name")" || exit 1
      for f in $files; do
        if [ "$(jq -r '.project' "$f")" = "$want" ]; then
          printf '%s' "$f"
          return 0
        fi
      done
    fi
    local names=""
    for f in $files; do names="$names $(jq -r '.project' "$f")"; done
    die_json "ambiguous_change" "change '$change' has applies in multiple projects:$names; pass --project to disambiguate"
  fi
  printf '%s' "$files"
}

# ----------------------------------------------------------------- status ---

agent_state_of() {
  local agent="$1" out
  if out="$(herdr agent get "$agent" 2>&1)"; then
    printf '%s' "$out" | jq -r '.result.agent.agent_status // "unknown"'
  else
    printf 'no_agent'
  fi
}

status_one() {
  local change="$1" project_name="$2" json_only="$3"
  local state_file project agent pane_id tab_id workspace_id last_state last_state_at
  state_file="$(find_state_file "$change" "$project_name")" || exit 1
  project="$(jq -r '.project' "$state_file")"
  agent="$(jq -r '.agent' "$state_file")"
  pane_id="$(jq -r '.pane_id' "$state_file")"
  tab_id="$(jq -r '.tab_id' "$state_file")"
  workspace_id="$(jq -r '.workspace_id' "$state_file")"
  last_state="$(jq -r '.last_state // ""' "$state_file")"
  last_state_at="$(jq -r '.last_state_at // ""' "$state_file")"

  local agent_state
  agent_state="$(agent_state_of "$agent")"

  local tasks_json tasks_open tasks_done tasks_total
  if [ -f "$project/openspec/changes/$change/tasks.md" ]; then
    tasks_open="$(grep -c '^[[:space:]]*- \[ \]' "$project/openspec/changes/$change/tasks.md" || true)"
    tasks_done="$(grep -c '^[[:space:]]*- \[x\]' "$project/openspec/changes/$change/tasks.md" || true)"
    tasks_total=$((tasks_open + tasks_done))
    tasks_json="$(jq -nc --argjson o "$tasks_open" --argjson d "$tasks_done" --argjson t "$tasks_total" '{missing: false, open: $o, done: $d, total: $t}')"
  else
    tasks_json='{"missing":true,"open":null,"done":null,"total":null}'
  fi

  local changed_files diff_stat
  changed_files="$(git -C "$project" status --short 2>/dev/null || true)"
  diff_stat="$(git -C "$project" diff --stat 2>/dev/null || true)"

  local dialog=""
  if [ "$agent_state" = "blocked" ]; then
    dialog="$(herdr agent read "$agent" --source visible 2>/dev/null || true)"
  fi

  local json
  json="$(jq -n \
    --arg change "$change" --arg project "$project" --arg agent "$agent" \
    --arg agent_state "$agent_state" --arg pane_id "$pane_id" --arg tab_id "$tab_id" \
    --arg workspace_id "$workspace_id" --arg last_state "$last_state" --arg last_state_at "$last_state_at" \
    --argjson tasks "$tasks_json" --arg dialog "$dialog" \
    --argjson changed_files "$(printf '%s' "$changed_files" | jq -Rsc 'split("\n") | map(select(length > 0))')" \
    --argjson diff_stat "$(printf '%s' "$diff_stat" | jq -Rsc 'split("\n") | map(select(length > 0))')" \
    '{change: $change, project: $project, agent: $agent, agent_state: $agent_state, pane_id: $pane_id, tab_id: $tab_id, workspace_id: $workspace_id, last_state: $last_state, last_state_at: $last_state_at, tasks: $tasks, git: {changed_files: $changed_files, diff_stat: $diff_stat}, blocked_dialog: (if $dialog == "" then null else $dialog end)}')"

  if [ "$json_only" -eq 1 ]; then
    printf '%s\n' "$json"
    return 0
  fi

  printf 'change: %s\n' "$change"
  printf 'project: %s\n' "$project"
  printf 'agent: %s (%s)\n' "$agent" "$agent_state"
  printf 'tab/pane: %s / %s (workspace %s)\n' "$tab_id" "$pane_id" "$workspace_id"
  if [ "$(printf '%s' "$tasks_json" | jq -r '.missing')" = "true" ]; then
    printf 'tasks: missing (no tasks.md)\n'
  else
    printf 'tasks: %s open, %s done\n' "$(printf '%s' "$tasks_json" | jq -r '.open')" "$(printf '%s' "$tasks_json" | jq -r '.done')"
  fi
  if [ -n "$changed_files" ]; then
    printf 'git status --short:\n%s\n' "$changed_files"
  else
    printf 'git: working tree clean\n'
  fi
  if [ -n "$diff_stat" ]; then
    printf 'git diff --stat:\n%s\n' "$diff_stat"
  fi
  if [ "$agent_state" = "blocked" ] && [ -n "$dialog" ]; then
    printf 'blocked dialog:\n%s\n' "$dialog"
  fi
  printf '%s\n' "$json"
}

status_all() {
  local json_only="$1"
  local files state_file agent agent_state e json="[]" idx
  files="$(ls "$BOSS_APPLIES_DIR"/*.json 2>/dev/null || true)"
  if [ "$json_only" -eq 0 ] && [ -z "$files" ]; then
    printf 'no applies recorded\n'
  fi
  idx=0
  for state_file in $files; do
    idx=$((idx + 1))
    agent="$(jq -r '.agent' "$state_file")"
    agent_state="$(agent_state_of "$agent")"
    e="$(jq -c --arg s "$agent_state" '. + {agent_state: $s} | {change, project, agent, agent_state, pane_id, tab_id, workspace_id, last_state, last_state_at}' "$state_file")"
    json="$(printf '%s' "$json" | jq -c --argjson e "$e" '. + [$e]')"
    if [ "$json_only" -eq 0 ]; then
      printf '%s) %s in %s: %s (%s)\n' "$idx" "$(jq -r '.change' "$state_file")" "$(jq -r '.project' "$state_file")" "$agent" "$agent_state"
    fi
  done
  printf '%s\n' "$json"
}

cmd_status() {
  ensure_boss_name status
  ensure_config
  local json_only=0 change="" project_name="" arg
  while [ $# -gt 0 ]; do
    arg="$1"; shift
    case "$arg" in
      --json) json_only=1 ;;
      --project) project_name="${1:-}"; shift ;;
      -h|--help) usage ;;
      --*) usage_error "unknown option: $arg" ;;
      *) if [ -z "$change" ]; then change="$arg"; else usage_error "unexpected argument: $arg"; fi ;;
    esac
  done
  if [ -z "$change" ]; then
    status_all "$json_only"
  else
    status_one "$change" "$project_name" "$json_only"
  fi
}

# --------------------------------------------------------------- retrigger ---

cmd_retrigger() {
  ensure_boss_name retrigger
  ensure_config
  local change="" project_name="" arg
  while [ $# -gt 0 ]; do
    arg="$1"; shift
    case "$arg" in
      --project) project_name="${1:-}"; shift ;;
      -h|--help) usage ;;
      --*) usage_error "unknown option: $arg" ;;
      *) if [ -z "$change" ]; then change="$arg"; else usage_error "unexpected argument: $arg"; fi ;;
    esac
  done
  [ -n "$change" ] || usage_error "usage: boss retrigger <change> [--project <name|path>]"

  local state_file agent apply_cmd waiter_pid out code
  state_file="$(find_state_file "$change" "$project_name")" || exit 1
  agent="$(jq -r '.agent' "$state_file")"
  apply_cmd="$(jq -r '.apply_cmd' "$state_file")"

  if ! herdr agent get "$agent" >/dev/null 2>&1; then
    die_json "agent_gone" "agent '$agent' no longer exists; start a new apply with 'boss dispatch $change'"
  fi

  waiter_pid="$(jq -r '.waiter_pid // empty' "$state_file")"
  if [ -n "$waiter_pid" ] && [ "$waiter_pid" != "null" ] && kill_waiter "$waiter_pid"; then
    log "retrigger: stopped old waiter pid $waiter_pid"
  fi

  send_prompt "$agent" "$apply_cmd"

  setsid -f "$BIN_DIR/boss-waiter" "$state_file" >/dev/null 2>&1
  log "retrigger: change=$change agent=$agent"

  printf '%s\n' "$(jq -n \
    --arg change "$change" --arg project "$(jq -r '.project' "$state_file")" \
    --arg agent "$agent" --arg status "retriggered" \
    '{change: $change, project: $project, agent: $agent, status: $status}')"
}

# ------------------------------------------------------------------ finish ---

cmd_finish() {
  ensure_boss_name finish
  ensure_config
  local change="" project_name="" force=0 arg
  while [ $# -gt 0 ]; do
    arg="$1"; shift
    case "$arg" in
      --project) project_name="${1:-}"; shift ;;
      --force) force=1 ;;
      -h|--help) usage ;;
      --*) usage_error "unknown option: $arg" ;;
      *) if [ -z "$change" ]; then change="$arg"; else usage_error "unexpected argument: $arg"; fi ;;
    esac
  done
  [ -n "$change" ] || usage_error "usage: boss finish <change> [--project <name|path>] [--force]"

  local state_file project tab_id waiter_pid
  state_file="$(find_state_file "$change" "$project_name")" || exit 1
  project="$(jq -r '.project' "$state_file")"
  tab_id="$(jq -r '.tab_id' "$state_file")"
  waiter_pid="$(jq -r '.waiter_pid // empty' "$state_file")"

  if [ "$force" -ne 1 ]; then
    if ! ls -d "$project"/openspec/changes/archive/*-"$change" >/dev/null 2>&1; then
      die_json "not_archived" "change '$change' is not archived in $project; archive it first (openspec archive) or use --force"
    fi
  fi

  if [ -n "$tab_id" ] && [ "$tab_id" != "null" ]; then
    if herdr tab close "$tab_id" >/dev/null 2>&1; then
      log "finish: closed tab $tab_id"
    else
      log "finish: tab $tab_id already gone"
    fi
  fi
  kill_waiter "$waiter_pid"
  rm -f "$state_file"
  log "finish: change=$change project=$project"

  printf '%s\n' "$(jq -n \
    --arg change "$change" --arg project "$project" --arg tab_id "$tab_id" --arg status "finished" \
    '{change: $change, project: $project, tab_id: $tab_id, status: $status}')"
}

# ------------------------------------------------------------------ answer ---

cmd_answer() {
  ensure_boss_name answer
  ensure_config
  local change="" project_name="" arg
  local -a keys=()
  while [ $# -gt 0 ]; do
    arg="$1"; shift
    case "$arg" in
      --project) project_name="${1:-}"; shift ;;
      -h|--help) usage ;;
      --*) usage_error "unknown option: $arg" ;;
      *) if [ -z "$change" ]; then change="$arg"; else keys+=("$arg"); fi ;;
    esac
  done
  [ -n "$change" ] || usage_error "usage: boss answer <change> <key>... [--project <name|path>]"
  [ "${#keys[@]}" -gt 0 ] || usage_error "usage: boss answer <change> <key>... [--project <name|path>]"

  local state_file agent out code
  state_file="$(find_state_file "$change" "$project_name")" || exit 1
  agent="$(jq -r '.agent' "$state_file")"

  if ! out="$(herdr agent send-keys "$agent" "${keys[@]}" 2>&1)"; then
    code="$(printf '%s' "$out" | jq -r '.error.code // "unknown"' 2>/dev/null || true)"
    die_json "send_keys_failed" "sending keys to $agent failed: $code"
  fi

  printf '%s\n' "$(jq -n \
    --arg change "$change" --arg agent "$agent" --arg status "sent" \
    --argjson keys "$(printf '%s\n' "${keys[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))')" \
    '{change: $change, agent: $agent, keys: $keys, status: $status}')"
}

# -------------------------------------------------------------------- main ---

main() {
  require_cmd jq
  case "${1:-}" in
    config-json) shift; config_json "$@" ;;
    dispatch) shift; cmd_dispatch "$@" ;;
    status) shift; cmd_status "$@" ;;
    retrigger) shift; cmd_retrigger "$@" ;;
    finish) shift; cmd_finish "$@" ;;
    answer) shift; cmd_answer "$@" ;;
    -h|--help) usage ;;
    "") usage ;;
    *) usage_error "unknown command: ${1:-}" ;;
  esac
}

main "$@"
